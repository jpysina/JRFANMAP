{
  "version": 8,
  "name": "GSI railway navigation",
  "glyphs": "https://maps.gsi.go.jp/xyz/noto-jp/{fontstack}/{range}.pbf",
  "sources": {
    "land": {
      "type": "geojson",
      "data": "asset://japan-boundary.geojson"
    },
    "gsi": {
      "type": "vector",
      "tiles": [
        "https://cyberjapandata.gsi.go.jp/xyz/experimental_bvmap/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 4,
      "maxzoom": 16,
      "attribution": "<a href=\"https://maps.gsi.go.jp/vector/\">地理院地図Vector</a>"
    }
  },
  "layers": [
    {"id": "sea", "type": "background", "paint": {"background-color": "#152839"}},
    {"id": "land", "type": "fill", "source": "land", "paint": {"fill-color": "#202338", "fill-opacity": 0.91, "fill-outline-color": "#364453"}},
    {"id": "wetlands", "type": "fill", "source": "gsi", "source-layer": "landforma", "minzoom": 8, "filter": ["==", "ftCode", 7401], "paint": {"fill-color": "#529C91", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.16, 14, 0.29]}},
    {"id": "surface-water", "type": "fill", "source": "gsi", "source-layer": "waterarea", "minzoom": 4, "paint": {"fill-color": "#43899F", "fill-opacity": 0.48, "fill-outline-color": "#45697C"}},
    {"id": "waterway-edge", "type": "line", "source": "gsi", "source-layer": "river", "minzoom": 10, "paint": {"line-color": "#5AA1B7", "line-opacity": 0.14, "line-blur": 1.1, "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.7, 14, 3.1, 18, 5.5]}},
    {"id": "waterways", "type": "line", "source": "gsi", "source-layer": "river", "minzoom": 8, "paint": {"line-color": "#65ABC4", "line-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.38, 13, 0.55, 17, 0.68], "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.45, 14, 1.2, 18, 2.7]}},
    {"id": "coastlines", "type": "line", "source": "gsi", "source-layer": "coastline", "minzoom": 12, "paint": {"line-color": "#6E99AE", "line-opacity": 0.38, "line-width": 0.75}},
    {"id": "administrative-boundaries", "type": "line", "source": "gsi", "source-layer": "boundary", "minzoom": 9, "paint": {"line-color": "#8794B3", "line-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0.21, 15, 0.3], "line-width": 0.8, "line-dasharray": [3, 3]}},
    {"id": "building-footprints", "type": "fill", "source": "gsi", "source-layer": "building", "minzoom": 14, "paint": {"fill-color": "#5E688A", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0.1, 16, 0.25, 19, 0.4]}},
    {"id": "local-roads", "type": "line", "source": "gsi", "source-layer": "road", "minzoom": 12, "paint": {"line-color": "#7389AF", "line-opacity": ["interpolate", ["linear"], ["zoom"], 12, 0.095, 14, 0.27, 17, 0.49], "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.4, 14, 0.85, 17, 2.2]}, "filter": ["all", ["has", "ftCode"], ["!in", "rdCtg", 0, 1], ["!=", "motorway", 1]], "layout": {"line-cap": "round", "line-join": "round"}},
    {"id": "major-road-case", "type": "line", "source": "gsi", "source-layer": "road", "minzoom": 8, "paint": {"line-color": "#171B30", "line-opacity": 0.49, "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.2, 12, 2.45, 15, 3.9, 18, 7]}, "filter": ["any", ["in", "rdCtg", 0, 1], ["==", "motorway", 1]], "layout": {"line-cap": "round", "line-join": "round"}},
    {"id": "major-roads", "type": "line", "source": "gsi", "source-layer": "road", "minzoom": 8, "paint": {"line-color": "#A0ADCB", "line-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.24, 12, 0.4, 17, 0.59], "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.55, 12, 1.28, 15, 2.1, 18, 5.1]}, "filter": ["any", ["in", "rdCtg", 0, 1], ["==", "motorway", 1]], "layout": {"line-cap": "round", "line-join": "round"}},
    {"id": "district-names", "type": "symbol", "source": "gsi", "source-layer": "label", "minzoom": 13, "paint": {"text-color": "#A8B4CC", "text-halo-color": "#1A2032", "text-halo-width": 1.2, "text-opacity": 0.83, "text-halo-blur": 0.18}, "filter": ["all", ["has", "knj"], ["in", "annoCtg", 210, 220]], "layout": {"text-field": ["get", "knj"], "text-font": ["NotoSansCJKjp-Regular"], "text-size": 10, "text-padding": 12}},
    {"id": "city-names", "type": "symbol", "source": "gsi", "source-layer": "label", "minzoom": 8, "paint": {"text-color": "#BECBDD", "text-halo-color": "#1A2032", "text-halo-width": 1.2, "text-opacity": 0.93}, "filter": ["all", ["has", "knj"], ["in", "annoCtg", 110, 120, 130, 140]], "layout": {"text-field": ["get", "knj"], "text-font": ["NotoSansCJKjp-Regular"], "text-size": 11, "text-padding": 12}}
  ]
}
