{
  "version": 8,
  "name": "GSI railway navigation",
  "glyphs": "https://maps.gsi.go.jp/xyz/noto-jp/{fontstack}/{range}.pbf",
  "sources": {
    "land": {
      "type": "geojson",
      "data": "asset://japan-boundary.geojson"
    },
    "gsi": {
      "type": "vector",
      "tiles": [
        "https://cyberjapandata.gsi.go.jp/xyz/experimental_bvmap/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 4,
      "maxzoom": 16,
      "attribution": "<a href=\"https://maps.gsi.go.jp/vector/\">地理院地図Vector</a>"
    }
  },
  "layers": [
    {"id": "sea", "type": "background", "paint": {"background-color": "#102434"}},
    {"id": "land", "type": "fill", "source": "land", "paint": {"fill-color": "#172632", "fill-outline-color": "#28404E"}},
    {"id": "surface-water", "type": "fill", "source": "gsi", "source-layer": "waterarea", "minzoom": 4, "paint": {"fill-color": "#235064", "fill-opacity": 0.78}},
    {"id": "waterways", "type": "line", "source": "gsi", "source-layer": "river", "minzoom": 8, "paint": {"line-color": "#346680", "line-opacity": 0.7, "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.45, 14, 1.2, 18, 2.7]}},
    {"id": "coastlines", "type": "line", "source": "gsi", "source-layer": "coastline", "minzoom": 12, "paint": {"line-color": "#355A6B", "line-opacity": 0.5, "line-width": 0.75}},
    {"id": "administrative-boundaries", "type": "line", "source": "gsi", "source-layer": "boundary", "minzoom": 9, "paint": {"line-color": "#587480", "line-opacity": 0.33, "line-width": 0.8, "line-dasharray": [3, 3]}},
    {"id": "building-footprints", "type": "fill", "source": "gsi", "source-layer": "building", "minzoom": 14, "paint": {"fill-color": "#405962", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0.06, 16, 0.26, 19, 0.46]}},
    {"id": "local-roads", "type": "line", "source": "gsi", "source-layer": "road", "minzoom": 12, "paint": {"line-color": "#415968", "line-opacity": ["interpolate", ["linear"], ["zoom"], 12, 0.13, 14, 0.42, 17, 0.64], "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.4, 14, 0.85, 17, 2.2]}, "filter": ["all", ["has", "ftCode"], ["!in", "rdCtg", 0, 1], ["!=", "motorway", 1]], "layout": {"line-cap": "round", "line-join": "round"}},
    {"id": "major-road-case", "type": "line", "source": "gsi", "source-layer": "road", "minzoom": 8, "paint": {"line-color": "#101E29", "line-opacity": 0.86, "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.2, 12, 2.45, 15, 3.9, 18, 7]}, "filter": ["any", ["in", "rdCtg", 0, 1], ["==", "motorway", 1]], "layout": {"line-cap": "round", "line-join": "round"}},
    {"id": "major-roads", "type": "line", "source": "gsi", "source-layer": "road", "minzoom": 8, "paint": {"line-color": "#637A82", "line-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.34, 12, 0.62, 17, 0.77], "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.55, 12, 1.28, 15, 2.1, 18, 5.1]}, "filter": ["any", ["in", "rdCtg", 0, 1], ["==", "motorway", 1]], "layout": {"line-cap": "round", "line-join": "round"}},
    {"id": "district-names", "type": "symbol", "source": "gsi", "source-layer": "label", "minzoom": 13, "paint": {"text-color": "#8BA6AB", "text-halo-color": "#172632", "text-halo-width": 1.2}, "filter": ["all", ["has", "knj"], ["in", "annoCtg", 210, 220]], "layout": {"text-field": ["get", "knj"], "text-font": ["NotoSansCJKjp-Regular"], "text-size": 10, "text-padding": 12}},
    {"id": "city-names", "type": "symbol", "source": "gsi", "source-layer": "label", "minzoom": 8, "paint": {"text-color": "#A9BFC5", "text-halo-color": "#172632", "text-halo-width": 1.2}, "filter": ["all", ["has", "knj"], ["in", "annoCtg", 110, 120, 130, 140]], "layout": {"text-field": ["get", "knj"], "text-font": ["NotoSansCJKjp-Regular"], "text-size": 11, "text-padding": 12}}
  ]
}
